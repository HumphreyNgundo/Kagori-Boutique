# Everything here is optional — the app boots with sensible fallbacks.

# Signs the staff session cookie. Set a long random string in production.
AUTH_SECRET=

# Added automatically when you connect a Vercel Blob store to the project.
# Present  -> orders, stock and uploaded product photos are durable.
# Absent   -> in-memory fallback: the demo works, but resets on redeploy.
BLOB_READ_WRITE_TOKEN=

# Reserved for the Postgres swap described in docs/ARCHITECTURE.md.
# POSTGRES_URL=
